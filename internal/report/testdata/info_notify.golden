a10r dev commit=test built=test

config dir: /home/test/.config/a10r
state dir:  /home/test/.local/state/a10r
log path:   /home/test/.local/state/a10r/a10r.log
aliases:    0
theme:      auto (terminal decides at start)

backends (1):
  prod-eu
    url:    https://am-prod-eu.internal

guardrails (1):
  tenants=prod-*  actions=*  deny

notify:
  desktop:      both
  min_severity: critical
  bell:         off
  command:      notify-send (+2 args)
